From: adorfer <adorferen@gmail.com>
Subject: [PATCH] gluon-mesh-vpn-tunneldigger: watchdog in shell, no restart without WAN IPv4

Port of Neanderfunk gluon-patches-fixes lowmem/tunneldigger-watchdog-shell
(v2023.2.x/v2025.1.x, incl. FirmwareConfigs e362e4d) to Gluon v2021.1.x.

- Shell instead of Lua: the watchdog runs every 5 minutes; on 4/32 devices
  the Lua runtime and simple-uci come from flash each time (measured on a
  WDR3600: cold 0.8-0.95 s in Lua, 0.3-0.4 s in shell).
- Same decisions as the 2021.1 Lua version, including its pid file check.
- New: without an IPv4 address on br-wan no restart; tunneldigger (IPv4 only)
  reaches no broker then, a restart just sets up the same failing loop.

The script moves from luasrc/ to files/: luasrcdiet would break shell.

---
diff --git a/package/gluon-mesh-vpn-tunneldigger/files/usr/bin/tunneldigger-watchdog b/package/gluon-mesh-vpn-tunneldigger/files/usr/bin/tunneldigger-watchdog
new file mode 100755
index 0000000..9665ddb
--- /dev/null
+++ b/package/gluon-mesh-vpn-tunneldigger/files/usr/bin/tunneldigger-watchdog
@@ -0,0 +1,27 @@
+#!/bin/sh
+# Restarts tunneldigger when the mesh VPN is enabled and either its pid file
+# does not match the running process, or batman-adv has no originator via
+# mesh-vpn. Same behaviour as the former Lua version (which loaded simple-uci
+# every five minutes), plus: no restart without an IPv4 address on br-wan.
+
+[ "$(uci -q get tunneldigger.mesh_vpn.enabled)" = 1 ] || exit 0
+
+restart() {
+	logger -t tunneldigger-watchdog "Restarting Tunneldigger."
+	/etc/init.d/tunneldigger restart
+	exit 0
+}
+
+if [ "$(pgrep -x /usr/bin/tunneldigger | head -n 1)" != "$(head -n 1 /var/run/tunneldigger.mesh-vpn.pid 2>/dev/null)" ]; then
+	logger -t tunneldigger-watchdog "Process-Pid does not match with pid-File."
+	restart
+fi
+
+# Without an IPv4 address on br-wan no broker is reachable (the client is
+# IPv4 only); a restart would just set up the same failing loop again.
+ip -4 addr show dev br-wan 2>/dev/null | grep 'inet ' >/dev/null || exit 0
+
+if ! batctl o | grep 'mesh-vpn' >/dev/null; then
+	logger -t tunneldigger-watchdog "No vpn-mesh neighbours found."
+	restart
+fi
diff --git a/package/gluon-mesh-vpn-tunneldigger/luasrc/usr/bin/tunneldigger-watchdog b/package/gluon-mesh-vpn-tunneldigger/luasrc/usr/bin/tunneldigger-watchdog
deleted file mode 100755
index e1b55a4..0000000
--- a/package/gluon-mesh-vpn-tunneldigger/luasrc/usr/bin/tunneldigger-watchdog
+++ /dev/null
@@ -1,46 +0,0 @@
-#!/usr/bin/lua
-
-local uci = require('simple-uci').cursor()
-
-local function restart_tunneldigger()
-	os.execute('logger -t tunneldigger-watchdog "Restarting Tunneldigger."')
-	os.execute('/etc/init.d/tunneldigger restart')
-end
-
-local function read_pid_file()
-	local pid_file = io.open('/var/run/tunneldigger.mesh-vpn.pid', 'r')
-	if not pid_file then
-		return nil
-	end
-	local pid = pid_file:read('*l')
-	pid_file:close()
-	return pid
-end
-
-local function has_mesh_vpn_neighbours()
-	local handle = io.popen('batctl o', 'r')
-	if not handle then
-		return false
-	end
-	for line in handle:lines() do
-		if line:find('mesh%-vpn') then
-			handle:close()
-			return true
-		end
-	end
-	handle:close()
-	return false
-end
-
-if uci:get_bool('tunneldigger', 'mesh_vpn', 'enabled') then
-	if io.popen('pgrep -x /usr/bin/tunneldigger'):read('*l') ~= read_pid_file() then
-		os.execute('logger -t tunneldigger-watchdog "Process-Pid does not match with pid-File."')
-		restart_tunneldigger()
-		return
-	end
-	if not has_mesh_vpn_neighbours() then
-		os.execute('logger -t tunneldigger-watchdog "No vpn-mesh neighbours found."')
-		restart_tunneldigger()
-		return
-	end
-end
