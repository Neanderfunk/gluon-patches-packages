+++ b/package/gluon-web-autoupdater/i18n/de.po
@@ -18,3 +18,6 @@ msgstr "Branch"
 
 msgid "Enable"
 msgstr "Aktivieren"
+
+msgid "The node receives security updates and does not fall behind when something changes in Freifunk, for example the VPN. Without updates it may lose its connection at some point."
+msgstr "Der Knoten erhält Sicherheitsupdates und bleibt nicht zurück, wenn sich im Freifunk etwas ändert, zum Beispiel am VPN. Ohne Updates verliert er irgendwann den Anschluss."
