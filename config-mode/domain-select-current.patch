@@ -41,9 +44,7 @@ return function(form, uci)
 	local s = form:section(Section, nil, site_i18n.translate('gluon-config-mode:domain-select'))
 	local o = s:option(ListValue, 'domain', site_i18n.translate('gluon-config-mode:domain'))
 
