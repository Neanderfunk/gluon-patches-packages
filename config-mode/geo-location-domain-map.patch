@@ -39,6 +39,35 @@
 			wrapper.addEventListener('gluon-show', function() {
 				map.updateSize();
 			});
+
+			// Neanderfunk: Ausschnitt folgt der Domain-Auswahl (Feld "domain"
+			// im selben Formular), solange der Knoten keine Position hat und
+			// niemand einen Punkt gesetzt oder Koordinaten eingetippt hat. Es
+			// wandert nur der Ausschnitt, nie die Koordinaten.
+			var domainMaps = <%=json(self.domain_maps or {})%>;
+			var follow = !<%=json(self:cfgvalue().set)%>;
+			map.on('click', function() { follow = false; });
+			document.addEventListener('input', function(e) {
+				if (e.target && (e.target === elLon || e.target === elLat))
+					follow = false;
+			});
+
+			var elForm = elMap.closest ? elMap.closest('form') : null;
+			var elDomain = (elForm || document).querySelector('select[name$=".domain"]');
+			var showDomain = function() {
+				var m = elDomain && domainMaps[elDomain.value];
+				if (!follow || !m)
+					return;
+				var view = map.getView();
+				view.setCenter(ol.proj.fromLonLat([m.lon, m.lat]));
+				if (typeof m.zoom === 'number')
+					view.setZoom(m.zoom);
+			};
+			if (elDomain) {
+				elDomain.addEventListener('change', showDomain);
+				// Auswahl schon geaendert, bevor OpenLayers geladen war
+				showDomain();
+			}
 		});
 	})();
 </script>
