+++ b/package/gluon-config-mode-domain-select/luasrc/lib/gluon/config-mode/wizard/0200-domain-select.lua
@@ -37,7 +37,8 @@ return function(form, uci)
 			end
 		end
 
-		table.sort(list, function(a, b) return a.domain_name < b.domain_name end)
+		-- Neanderfunk: sorted by code (01_vel, 02_met, ...), like the label
+		table.sort(list, function(a, b) return a.domain_code < b.domain_code end)
 		return list
 	end
 
@@ -47,7 +48,9 @@ return function(form, uci)
 	o.default = selected_domain
 
