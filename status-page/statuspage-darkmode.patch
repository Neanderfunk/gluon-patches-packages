diff --git a/package/gluon-status-page/sass/status-page.scss b/package/gluon-status-page/sass/status-page.scss
index c093f17..24f312f 100644
--- a/package/gluon-status-page/sass/status-page.scss
+++ b/package/gluon-status-page/sass/status-page.scss
@@ -242,3 +242,64 @@ canvas.signalgraph {
 		}
 	}
 }
+
+/*
+	Neanderfunk: Darkmode nach prefers-color-scheme. Farben aus dem Darkmode
+	von neanderfunk-config-mode-theme (neanderfunk.css), damit Statusseite und
+	Config-Mode gleich aussehen. Steht am Ende, damit er die hellen Regeln
+	oben ueberschreibt.
+*/
+@media (prefers-color-scheme: dark) {
+	:root {
+		color-scheme: dark;
+	}
+
+	body {
+		background: #131015;
+		color: #eee8f1;
+	}
+
+	a {
+		color: #e0317d;
+
+		&:hover {
+			color: #ee4b90;
+		}
+	}
+
+	h2, h3, dd, td {
+		color: #a79dad;
+	}
+
+	dt, th, td::before {
+		color: #eee8f1;
+	}
+
+	header {
+		background: #3a1628;
+		color: #eee8f1;
+		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
+	}
+
+	.container {
+		background: #1c181f;
+		box-shadow: 0 12px 34px rgba(0, 0, 0, 0.55), 0 2px 6px rgba(0, 0, 0, 0.4);
+
+		& > .frame {
+			border-color: #322b37;
+		}
+	}
+
+	table.datatable tr.highlight {
+		background: rgba(255, 194, 61, 0.18);
+	}
+
+	/*
+		Der Signalgraph zeichnet Raster und Rahmen in Schwarz (status-page.js).
+		Umkehren und den Farbton zurueckdrehen: Raster und Rahmen werden hell,
+		die Linien der Nachbarn behalten ihren Farbton (nur hellere Toene).
+	*/
+	canvas.signalgraph {
+		filter: invert(1) hue-rotate(180deg);
+	}
+}
