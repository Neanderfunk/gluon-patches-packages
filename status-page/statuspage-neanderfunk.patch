 		'id': function(value) {
 			return value;
 		},
+		// Neanderfunk (neanderfunk-respondd): Ethernet-Port {carrier, speed, duplex, possible}
+		'nfLink': function(value) {
+			if (!value || typeof value !== 'object')
+				return '-';
+			if (!value.carrier)
+				return '\u2013';
+			if (!(value.speed > 0))
+				return 'up';
+			var s = value.speed + ' MBit/s';
+			if (value.duplex === 'half')
+				s += ' (half duplex)';
+			else if (value.possible > value.speed)
+				s += ' (' + value.possible + ' possible)';
+			return s;
+		},
+		// ssid_changer.offline 0/1 als Zustandswort
+		'nfOffline': function(value) {
+			return value == 1 ? 'offline' : value == 0 ? 'online' : '\u2013';
+		},
+		'nfTemp': function(value) {
+			return typeof value === 'number' ? Math.round(value) + ' \u00b0C' : '\u2013';
+		},
+		// live gesendete SSID (nl80211), leer = Interface funkt nicht
+		'nfSsid': function(value) {
+			return value || '\u2013';
+		},
+		// Gateway mit Hostnamen (neanderfunk-status-page: cgi-bin/dyn/gateway-name),
+		// einmal je MAC, ohne Antwort nach 5 min erneut; bis dahin die MAC
+		'gateway': (function() {
+			var names = {}, retry = {};
+			return function(addr) {
+				if (!addr)
+					return '';
+				if (!names[addr] && !(retry[addr] > Date.now())) {
+					retry[addr] = Date.now() + 300000;
+					var xhr = new XMLHttpRequest();
+					xhr.onload = function() {
+						var name = xhr.status === 200 ? xhr.responseText.trim() : '';
+						if (name)
+							names[addr] = name;
+					};
+					xhr.open('GET', '/cgi-bin/dyn/gateway-name?' + encodeURIComponent(addr));
+					xhr.send();
+				}
+				if (!names[addr])
+					return addr;
+				var span = document.createElement('span');
+				span.title = addr;
+				span.textContent = names[addr];
+				return span;
+			};
+		})(),
 		'decimal': function(value) {
 			return formatNumberFixed(value, 2);
 		},
