+	-- Rolle je Port aus gluon.iface_* (Konfiguration, nicht live),
+	-- ausgeschrieben: Uplink/VPN (dort laeuft das Mesh-VPN), Mesh, Client;
+	-- mehrere durch Komma. "/lan" usw. steht fuer die Ports in sysconfig
+	-- lan_ifname. Ports, die respondd nicht einzeln kennt (swconfig: LAN ist
+	-- eth0.1 am Switch), bekommen eine Zeile je Gruppe statt je Port.
+	local ROLE_ORDER = { 'uplink', 'mesh', 'client' }
+	local role_title = {
+		uplink = nf.translate('Uplink/VPN'),
+		mesh = nf.translate('Mesh'),
+		client = nf.translate('Client'),
+	}
+	local port_roles, role_groups = {}, {}
+	local function role_cell(set)
+		local titles = {}
+		for _, r in ipairs(ROLE_ORDER) do
+			if set[r] then
+				table.insert(titles, role_title[r])
+			end
+		end
+		return titles[1] and table.concat(titles, ', ') or nil
+	end
+	do
+		local known = {}
+		for _, l in ipairs(ethlinks) do known[l.name] = true end
+		uci:foreach('gluon', 'interface', function(sec)
+			local name = sec.name
+			if type(name) == 'table' then name = table.concat(name, ' ') end
+			if type(name) ~= 'string' then return end
+			if name:sub(1, 1) == '/' then
+				name = util.readfile('/lib/gluon/core/sysconfig/' .. name:sub(2) .. '_ifname') or ''
+			end
+			local roles = sec.role
+			if type(roles) ~= 'table' then roles = { roles } end
+			local set, ports, unknown = {}, {}, false
+			for _, r in ipairs(roles) do set[r] = true end
+			for port in name:gmatch('%S+') do
+				table.insert(ports, port)
+				port_roles[port] = port_roles[port] or {}
+				for r in pairs(set) do port_roles[port][r] = true end
+				if not known[port] then unknown = true end
+			end
+			local titles = role_cell(set)
+			if unknown and titles then
+				local label = sec['.name']:gsub('^iface_', '')
+				label = (label == 'lan' or label == 'wan') and label:upper() or label
+				table.insert(role_groups, { label = label, ports = table.concat(ports, ' '),
+					titles = titles })
+			end
+		end)
+		table.sort(role_groups, function(a, b) return a.label < b.label end)
+	end
