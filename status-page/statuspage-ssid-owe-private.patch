+	-- Neben dem Client-AP: das OWE-BSS (owe_radioN, Interface oweN) und das
+	-- private WLAN (wan_radioN, Interface wl-wanN, nur mit Rolle "private").
+	-- nil, wenn es die Sektion nicht gibt (keine Zeile). Sonst die SSID, die
+	-- das Interface gerade funkt, oder false, wenn es aus ist - abgeschaltet
+	-- (auch als Laufzeit-Delta von ap-timer oder ssid-changer) oder nicht
+	-- hochgekommen. Den Schluessel des privaten WLANs zeigt die Seite nie, sie
+	-- ist ohne Anmeldung erreichbar.
+	local function ap_ssid(section, ifname)
+		if not uci:get('wireless', section) then
+			return nil
+		end
+		local d = uci:get('wireless', section, 'disabled')
+		if d == '1' or d == 'true' or d == 'yes' or d == 'on' or d == 'enabled' then
+			return false
+		end
+		return (ifname and iwinfo.nl80211.ssid(ifname)) or false
+	end
+
